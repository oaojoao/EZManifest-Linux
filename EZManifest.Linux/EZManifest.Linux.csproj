    <Compile Include="..\EZManifest\Models\DownloadItem.cs" Link="Shared\Models\DownloadItem.cs" />
    <Compile Include="..\EZManifest\Models\DownloadProgress.cs" Link="Shared\Models\DownloadProgress.cs" />
    <Compile Include="..\EZManifest\Models\FileExplorerPicker.cs" Link="Shared\Models\FileExplorerPicker.cs" />
    <Compile Include="..\EZManifest\Models\GameEntry.cs" Link="Shared\Models\GameEntry.cs" />
    <Compile Include="..\EZManifest\Models\GameMediaItem.cs" Link="Shared\Models\GameMediaItem.cs" />
    <Compile Include="..\EZManifest\Models\InstalledDepotRecord.cs" Link="Shared\Models\InstalledDepotRecord.cs" />
