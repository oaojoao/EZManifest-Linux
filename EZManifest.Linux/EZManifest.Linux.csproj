<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>EZManifest.Linux</RootNamespace>
    <AssemblyName>EZManifest</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComSupport>false</BuiltInComSupport>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationManifest="" />
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="App.axaml.cs" />
    <Compile Include="MainWindow.axaml.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Shims\**\*.cs" />
    <Compile Include="Services\**\*.cs" />
    <Compile Include="ViewModels\**\*.cs" />
    <Compile Include="Views\**\*.cs" />
  </ItemGroup>

  <!-- Portable business logic shared with the Windows project -->
  <ItemGroup>
    <Compile Include="..\EZManifest\Models\AppConfig.cs" Link="Shared\Models\AppConfig.cs" />
    <Compile Include="..\EZManifest\Models\AppSettings.cs" Link="Shared\Models\AppSettings.cs" />
    <Compile Include="..\EZManifest\Models\DataColor.cs" Link="Shared\Models\DataColor.cs" />
