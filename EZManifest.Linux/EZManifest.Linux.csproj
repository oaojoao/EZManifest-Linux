    <Compile Include="..\EZManifest\Models\ManifestArchiveResult.cs" Link="Shared\Models\ManifestArchiveResult.cs" />
    <Compile Include="..\EZManifest\Models\SteamCdnRegion.cs" Link="Shared\Models\SteamCdnRegion.cs" />
