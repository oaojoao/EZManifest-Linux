<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="EZManifest.Linux.Views.DepotBoxPage">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1e1e24" />
      <Setter Property="BorderBrush" Value="#32323a" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Button.navbtn">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20,24,24">
    <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,12">
      <TextBlock Text="DepotBox" FontSize="24" FontWeight="Bold" />
      <Border Classes="card">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
            <Button Grid.Column="0" Classes="navbtn" Content="←" Click="OnGoBack" ToolTip.Tip="Back" />
            <TextBox Grid.Column="1" Text="{Binding Address, Mode=TwoWay}" Margin="8,0,8,0"
                     Watermark="https://depotbox.org/" />
            <Button Grid.Column="2" Classes="navbtn" Content="Go" Command="{Binding GoCommand}" />
            <Button Grid.Column="3" Classes="navbtn" Content="Home" Command="{Binding GoHomeCommand}" Margin="8,0,0,0" />
            <Button Grid.Column="4" Classes="navbtn" Content="Reload" Click="OnReload" Margin="8,0,0,0" />
            <Button Grid.Column="5" Classes="navbtn" Content="Open in browser" Click="OnOpenExternal" Margin="8,0,0,0"
                    ToolTip.Tip="Open the current page in the system browser" />
          </Grid>
          <TextBlock Text="{Binding StatusText}" Opacity="0.7" FontSize="12" />
        </StackPanel>
      </Border>
    </StackPanel>

    <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0,0,0,8" IsVisible="{Binding IsBusy}" />

    <Border Grid.Row="2" Classes="card" Padding="0" MinHeight="320">
      <Panel x:Name="BrowserHost" />
    </Border>

    <ItemsControl Grid.Row="3" ItemsSource="{Binding BrowserDownloads}" Margin="0,12,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="card" Margin="0,0,0,8" Padding="12">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" FontWeight="SemiBold" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status}" Opacity="0.7" />
              <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Percentage}" Maximum="100"
                           MinHeight="6" Margin="0,6,0,0" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>
