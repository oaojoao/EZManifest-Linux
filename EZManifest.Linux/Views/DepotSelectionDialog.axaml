<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:EZManifest.Linux.ViewModels"
            x:Class="EZManifest.Linux.Views.DepotSelectionDialog"
            x:DataType="vm:DepotSelectionViewModel">
    <StackPanel Spacing="12">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Opacity="0.75" />
        <Border BorderBrush="#3a3a40" BorderThickness="1" CornerRadius="4" Padding="8"
                MaxHeight="360">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DepotId}" VerticalAlignment="Center" Opacity="0.6" />
                                <TextBlock Text="{Binding SizeText}" VerticalAlignment="Center" Opacity="0.6" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding ShowInstallOptions}">
            <CheckBox Content="Remove Steam DRM" IsChecked="{Binding RemoveSteamDrm, Mode=TwoWay}" />
            <CheckBox Content="Add game to Steam" IsChecked="{Binding AddToSteam, Mode=TwoWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
