<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="EZManifest.Linux.Views.PatchPage">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1e1e24" />
            <Setter Property="BorderBrush" Value="#32323a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#0F9D58" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.navbtn">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="24,20,24,24">
        <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,12">
            <TextBlock Classes="h1" Text="Patch games" />
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="muted"
                               Text="Browse GameCopyWorld below, download a patch archive, then apply it to an installed game. Downloaded archives are extracted automatically." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Import patch archive..." Command="{Binding BrowsePatchArchiveCommand}" />
                        <Button Content="Apply patch" Command="{Binding ApplyPatchCommand}" Classes="accent" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0,0,0,12" IsVisible="{Binding IsBusy}" />

        <Border Grid.Row="2" Classes="card" Padding="12" MinHeight="340">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                    <Button Grid.Column="0" Classes="navbtn" Content="←" Click="OnGoBack" ToolTip.Tip="Back" />
                    <Button Grid.Column="1" Classes="navbtn" Content="Reload" Click="OnReload" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Classes="navbtn" Content="Home" Click="OnGoHome" Margin="8,0,0,0"
                            ToolTip.Tip="Back to GameCopyWorld" />
                    <Button Grid.Column="3" Classes="navbtn" Content="Open in browser" Click="OnOpenExternal" Margin="8,0,0,0"
                            ToolTip.Tip="Open the current page in the system browser" />
                    <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="Gray" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Panel Grid.Row="1" x:Name="GcwBrowserHost" MinHeight="280" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <ItemsControl Grid.Row="3" ItemsSource="{Binding BrowserDownloads}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="card" Margin="0,0,0,8" Padding="12">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Status}" Opacity="0.7" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Percentage}" Maximum="100"
                                         MinHeight="6" Margin="0,6,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DataGrid Grid.Row="4" ItemsSource="{Binding InstalledGames}" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="Transparent" RowBackground="Transparent" Height="180" Margin="0,12,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="300" />
                <DataGridTextColumn Header="Install path" Binding="{Binding InstallPath}" Width="500" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
