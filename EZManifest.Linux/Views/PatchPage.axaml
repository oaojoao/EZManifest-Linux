<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="EZManifest.Linux.Views.PatchPage">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1e1e24" />
            <Setter Property="BorderBrush" Value="#32323a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#0F9D58" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,20,24,24">
        <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="Patch games" />
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="muted"
                               Text="Download a patch archive (e.g. from gamecopyworld via your browser), then import it here and apply it to an installed game." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Open gamecopyworld" Click="OnOpenGamecopyworld" />
                        <Button Content="Import patch archive..." Command="{Binding BrowsePatchArchiveCommand}" />
                        <Button Content="Apply patch" Command="{Binding ApplyPatchCommand}" Classes="accent" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0,0,0,12" IsVisible="{Binding IsBusy}" />
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="Gray" Margin="0,0,0,16" TextWrapping="Wrap" />
        <DataGrid Grid.Row="3" ItemsSource="{Binding InstalledGames}" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="Transparent" RowBackground="Transparent">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="300" />
                <DataGridTextColumn Header="Install path" Binding="{Binding InstallPath}" Width="500" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
