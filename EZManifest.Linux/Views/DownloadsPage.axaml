<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="EZManifest.Linux.Views.DownloadsPage">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1e1e24" />
      <Setter Property="BorderBrush" Value="#32323a" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#0F9D58" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#18C46A" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,20,24,24">
    <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,16">
      <TextBlock Classes="h1" Text="Downloads" />
      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="🔗" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="DepotBox" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBox Grid.Column="0" Text="{Binding DepotBoxUrl, Mode=TwoWay}"
                     Watermark="https://depotbox.org/" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Open in browser" Command="{Binding OpenDepotBoxInBrowserCommand}"
                    Margin="8,0,0,0" />
            <Button Grid.Column="2" Content="Save source" Command="{Binding SaveSourceCommand}"
                    Margin="8,0,0,0" />
            <Button Grid.Column="3" Content="Import manifest .zip..." Command="{Binding BrowseArchiveCommand}"
                    Classes="accent" Margin="8,0,0,0" />
          </Grid>
          <TextBlock Text="{Binding DepotBoxUrlError}" Foreground="OrangeRed" Opacity="0.9"
                     IsVisible="{Binding DepotBoxUrlError}" FontSize="12" />
          <TextBlock Text="{Binding DepotBoxHint}" TextWrapping="Wrap" Opacity="0.65" FontSize="12" />
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16" IsVisible="{Binding IsBusy}">
      <ProgressBar IsIndeterminate="True" />
      <TextBlock Text="{Binding StatusText}" Foreground="Gray" FontSize="12" />
    </StackPanel>

    <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="Gray" Margin="0,0,0,12"
               IsVisible="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}" />

    <DataGrid Grid.Row="3" ItemsSource="{Binding Downloads}" AutoGenerateColumns="False" IsReadOnly="True"
              Background="Transparent" RowBackground="Transparent">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Game" Binding="{Binding GameName}" Width="240" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="240" />
        <DataGridTemplateColumn Header="Progress" Width="300">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Spacing="4" Margin="0,6">
                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" MinHeight="8" />
                <StackPanel Orientation="Horizontal" Spacing="12" Opacity="0.65">
                  <TextBlock Text="{Binding SizeProgressText}" FontSize="11" />
                  <TextBlock Text="{Binding ElapsedText}" FontSize="11" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Actions" Width="200">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4">
                <Button Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
