<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="EZManifest.Linux.Views.SettingsPage">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1e1e24" />
      <Setter Property="BorderBrush" Value="#32323a" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#0F9D58" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#18C46A" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Padding="24,20,24,24">
    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">
      <TextBlock Classes="h1" Text="Settings" Margin="0,0,0,8" />

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Install path" />
          <TextBlock Classes="muted" Text="Where downloaded games are stored on disk." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding DownloadPath, Mode=TwoWay}" Width="420"
                      Watermark="Choose where games are installed..." />
            <Button Content="Browse" Command="{Binding BrowseDownloadPathCommand}" />
            <Button Content="Apply" Command="{Binding ApplyDownloadPathCommand}" Classes="accent" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Proton" />
          <TextBlock Classes="muted" Text="Windows executables launch through the selected Proton build (official or GE). 'Auto' picks the newest installed version." />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <ToggleSwitch IsChecked="{Binding UseProton, Mode=TwoWay}" />
            <TextBlock Text="Play with Proton" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding ProtonVersions}" SelectedItem="{Binding ProtonVersion, Mode=TwoWay}"
                      MinWidth="220" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Global WINE prefix (optional)" VerticalAlignment="Center" Opacity="0.8" />
            <TextBox Text="{Binding ProtonGlobalPrefixPath, Mode=TwoWay}" Width="360"
                     Watermark="Empty = one prefix per game" />
            <Button Content="Browse" Command="{Binding BrowsePrefixPathCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <TextBlock Text="Proton env vars (optional)" VerticalAlignment="Center" Opacity="0.8" />
            <TextBox Text="{Binding ProtonEnvironmentVariables, Mode=TwoWay}" Width="360"
                     Watermark="e.g. PROTON_LOG=1 DXVK_HUD=1 PROTON_USE_WINED3D=1" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Download concurrency" />
          <TextBlock Classes="muted" Text="Maximum parallel chunk downloads from the Steam CDN." />
          <NumericUpDown Value="{Binding MaxConcurrentChunks, Mode=TwoWay}" Minimum="1" Maximum="64" Width="120" />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding StatusText}" Foreground="#18C46A" IsVisible="{Binding StatusText}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
