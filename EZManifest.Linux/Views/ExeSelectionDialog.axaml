<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:EZManifest.Linux.ViewModels"
            x:Class="EZManifest.Linux.Views.ExeSelectionDialog"
            x:DataType="vm:ExeSelectionViewModel">
    <StackPanel Spacing="12">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
        <Border BorderBrush="#3a3a40" BorderThickness="1" CornerRadius="4" Padding="8" MaxHeight="320">
            <ScrollViewer>
                <ListBox ItemsSource="{Binding Executables}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" />
            </ScrollViewer>
        </Border>
        <Button Content="Browse for another executable..." Command="{Binding BrowseCommand}"
                IsVisible="{Binding AllowBrowse}" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
