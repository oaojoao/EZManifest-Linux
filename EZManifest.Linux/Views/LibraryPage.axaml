<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:EZManifest.Linux.ViewModels"
            xmlns:models="using:EZManifest.Models"
            xmlns:svc="using:EZManifest.Linux.Services"
            x:Class="EZManifest.Linux.Views.LibraryPage">
  <UserControl.Resources>
    <svc:PathToImageConverter x:Key="PathToImage" />
    <svc:UrlToBitmapConverter x:Key="UrlToBitmap" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1e1e24" />
      <Setter Property="BorderBrush" Value="#34343c" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="RenderTransform">
        <TranslateTransform />
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="Background" Value="#26262e" />
      <Setter Property="BorderBrush" Value="#18C46A" />
      <Setter Property="RenderTransform">
        <TranslateTransform Y="-3" />
      </Setter>
    </Style>
    <Style Selector="Border.detail">
      <Setter Property="Background" Value="#1e1e24" />
      <Setter Property="BorderBrush" Value="#34343c" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.play">
      <Setter Property="Background" Value="#0F9D58" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.play:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#18C46A" />
    </Style>
    <Style Selector="Button.iconbtn">
      <Setter Property="Background" Value="#2a2a30" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.mediabtn">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Black" />
    </Style>
    <Style Selector="Button.mediabtn:pointerover /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.playhint">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Background" Value="#CC101014" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.card:pointerover > StackPanel > Border > Grid > Border.playhint">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="16,12,16,16">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="8,0,0,12">
      <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="Search games..." Width="280" />
      <Button Classes="iconbtn" Width="40" Height="40" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh library">
        <PathIcon Width="16" Height="16"
                  Data="M17.65,6.35A8,8 0 1,0 19.73,14H17.65A6,6 0 1,1 12,6A6,6 0 0,1 16.24,7.76L13,11H20V4L17.65,6.35Z" />
      </Button>
      <Border Background="#26262e" CornerRadius="10" Padding="12,5" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.8" />
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="1" x:Name="LibraryScroll" ScrollChanged="OnLibraryScrollChanged">
      <ItemsControl ItemsSource="{Binding ShownGames}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:GameEntry">
            <Border Classes="card" Margin="0,0,10,10" Width="200"
                    PointerReleased="OnCardPointerReleased" Tag="{Binding}">
              <StackPanel>
                <Border Height="260" CornerRadius="9,9,0,0" ClipToBounds="True" Background="#141419">
                  <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" Opacity="0.55" Text="No art"
                               IsVisible="{Binding CoverArtIsMissing}" />
                    <Image Source="{Binding Image, Converter={StaticResource PathToImage}}" Stretch="UniformToFill"
                           IsVisible="{Binding HasCoverArt}" />
                    <Border Classes="playhint" IsVisible="{Binding IsInstalled}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="12" Height="12" Foreground="#7CE6A9"
                                  Data="M8,5.14V19.14L19,12.14L8,5.14Z" />
                        <TextBlock Text="Play" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
                <StackPanel Spacing="6" Margin="10,8,10,10">
                  <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.7"
                             Text="{Binding InstallSizeText}"
                             IsVisible="{Binding HasInstallSize}" />
                  <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}"
                             TextWrapping="Wrap" MaxLines="2" TextAlignment="Center"
                             MinHeight="36" />
                  <Button Classes="play" Content="Play" HorizontalAlignment="Stretch"
                          Command="{Binding $parent[ItemsControl].DataContext.PlayCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="1" IsVisible="{Binding !HasGames}" VerticalAlignment="Center"
                HorizontalAlignment="Center" Spacing="10">
      <PathIcon Width="40" Height="40" Opacity="0.3"
                Data="M3,5H11V11H3M13,5H21V11H13M3,13H11V19H3M13,13H21V19H13Z" />
      <TextBlock Text="No games yet" FontSize="16" FontWeight="SemiBold" Opacity="0.7"
                 HorizontalAlignment="Center" />
      <TextBlock Text="Download a game from DepotBox or import a manifest archive from the Downloads page."
                 FontSize="12" Opacity="0.5" HorizontalAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="2" Classes="detail" Margin="0,12,0,0"
            IsVisible="{Binding HasSelectedGame}">
      <ScrollViewer MaxHeight="560" Padding="20,14,20,16"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="980" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" x:DataType="models:GameEntry"
                DataContext="{Binding SelectedGame}">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="label" Text="INSTALL SIZE" IsVisible="{Binding HasInstallSize}" />
                  <TextBlock FontSize="14" Text="{Binding InstallSizeText}" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="label" Text="STATUS" />
                  <TextBlock FontSize="14" Text="{Binding $parent[UserControl].DataContext.SelectedGameStatus}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Classes="iconbtn" Width="40" Height="40" Margin="8,0,0,0"
                    ToolTip.Tip="Open install folder"
                    Command="{Binding $parent[UserControl].DataContext.OpenFolderCommand}"
                    CommandParameter="{Binding}">
              <PathIcon Width="16" Height="16"
                        Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" />
            </Button>
            <Button Grid.Column="2" Classes="iconbtn" Width="40" Height="40" Margin="8,0,0,0"
                    ToolTip.Tip="Store page"
                    Command="{Binding $parent[UserControl].DataContext.OpenStorePageCommand}"
                    CommandParameter="{Binding}">
              <PathIcon Width="16" Height="16"
                        Data="M16.36,14C16.44,13.34 16.5,12.68 16.5,12C16.5,11.32 16.44,10.66 16.36,10H19.74C19.9,10.64 20,11.31 20,12C20,12.69 19.9,13.36 19.74,14H16.36M14.59,19.56C15.19,18.45 15.65,17.25 15.97,16H18.92C17.96,17.65 16.43,18.93 14.59,19.56M14.34,14H9.66C9.56,13.34 9.5,12.68 9.5,12C9.5,11.32 9.56,10.65 9.66,10H14.34C14.43,10.65 14.5,11.32 14.5,12C14.5,12.68 14.43,13.34 14.34,14M12,4.03C13.17,5.63 14.11,7.58 14.66,9.53H9.34C9.89,7.58 10.83,5.63 12,4.03M5.08,16H8.03C8.35,17.25 8.81,18.45 9.41,19.56C7.57,18.93 6.04,17.65 5.08,16M8.03,8H5.08C6.04,6.34 7.57,5.06 9.41,4.44C8.81,5.55 8.35,6.75 8.03,8M4.26,14C4.1,13.36 4,12.69 4,12C4,11.31 4.1,10.64 4.26,10H7.64C7.56,10.66 7.5,11.32 7.5,12C7.5,12.68 7.56,13.34 7.64,14H4.26M12,19.97C10.83,18.36 9.89,16.41 9.34,14H14.66C14.11,16.41 13.17,18.36 12,19.97M18.92,8H15.97C15.65,6.75 15.19,5.55 14.59,4.44C16.43,5.07 17.96,6.34 18.92,8M12,2C7.58,2 4,5.58 4,10C4,14.42 7.58,18 12,18C16.42,18 20,14.42 20,10C20,5.58 16.42,2 12,2Z" />
            </Button>
            <Button x:Name="ProtonSettingsButton" Grid.Column="3" Classes="iconbtn" Width="40" Height="40" Margin="8,0,0,0"
                    ToolTip.Tip="Proton settings"
                    Command="{Binding $parent[UserControl].DataContext.OpenProtonSettingsCommand}"
                    CommandParameter="{Binding}">
              <PathIcon Width="16" Height="16"
                        Data="M19.14,12.94C19.18,12.64 19.2,12.33 19.2,12C19.2,11.67 19.18,11.36 19.13,11.06L21.16,9.48C21.34,9.34 21.39,9.09 21.28,8.89L19.36,5.57C19.24,5.37 19,5.29 18.8,5.37L16.41,6.33C15.91,5.96 15.37,5.67 14.79,5.45L14.43,2.91C14.39,2.69 14.2,2.53 14,2.53H10.16C9.95,2.53 9.77,2.69 9.73,2.91L9.37,5.45C8.79,5.67 8.25,5.96 7.75,6.33L5.36,5.37C5.16,5.29 4.92,5.37 4.8,5.57L2.88,8.89C2.77,9.09 2.82,9.34 3,9.48L5.03,11.06C4.98,11.36 4.96,11.67 4.96,12C4.96,12.33 4.98,12.64 5.03,12.94L3,14.52C2.82,14.66 2.77,14.91 2.88,15.11L4.8,18.43C4.92,18.63 5.16,18.71 5.36,18.63L7.75,17.67C8.25,18.04 8.79,18.33 9.37,18.55L9.73,21.09C9.77,21.31 9.95,21.47 10.16,21.47H14C14.2,21.47 14.39,21.31 14.43,21.09L14.79,18.55C15.37,18.33 15.91,18.04 16.41,17.67L18.8,18.63C19,18.71 19.24,18.63 19.36,18.43L21.28,15.11C21.39,14.91 21.34,14.66 21.16,14.52L19.14,12.94M12,15.6A3.6,3.6 0 0,1 8.4,12A3.6,3.6 0 0,1 12,8.4A3.6,3.6 0 0,1 15.6,12A3.6,3.6 0 0,1 12,15.6Z" />
            </Button>
            <Button Grid.Column="4" Classes="iconbtn" Width="40" Height="40" Margin="8,0,0,0"
                    ToolTip.Tip="Uninstall"
                    Command="{Binding $parent[UserControl].DataContext.UninstallCommand}"
                    CommandParameter="{Binding}">
              <PathIcon Width="16" Height="16"
                        Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M9,9H11V17H9V9M13,9H15V17H13V9Z" />
            </Button>
            <Button Grid.Column="5" Classes="iconbtn" Width="40" Height="40" Margin="8,0,0,0"
                    ToolTip.Tip="Close details"
                    Command="{Binding $parent[UserControl].DataContext.CloseDetailCommand}">
              <PathIcon Width="16" Height="16"
                        Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
            </Button>
          </Grid>

          <Border CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Center"
                  IsVisible="{Binding $parent[UserControl].DataContext.HasSelectedGameHero}">
            <Image Source="{Binding SelectedGameHeroPath, Converter={StaticResource PathToImage}}"
                   Stretch="Uniform" MaxHeight="240" />
          </Border>

          <StackPanel Spacing="8" IsVisible="{Binding $parent[UserControl].DataContext.HasSelectedGameMedia}">
            <TextBlock Classes="label" Text="GAME MEDIA" />
            <ItemsControl ItemsSource="{Binding SelectedGameMedia}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:GameMediaItem">
                  <Button Classes="mediabtn" Margin="0,0,8,8" Click="OnOpenMedia"
                          Tag="{Binding}" Cursor="Hand"
                          ToolTip.Tip="View media">
                    <Border Width="240" Height="135" Background="#141419" CornerRadius="6" ClipToBounds="True">
                      <Grid>
                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UrlToBitmap}}" Stretch="Uniform" />
                        <Border Background="#99000000" CornerRadius="4" Padding="7,3"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                IsVisible="{Binding IsVideo}">
                          <TextBlock Text="▶ Video" FontSize="10" Foreground="White" />
                        </Border>
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="8" x:DataType="models:GameEntry" DataContext="{Binding SelectedGame}">
            <TextBlock Classes="label" Text="ABOUT THE GAME" />
            <ItemsControl ItemsSource="{Binding AboutTheGameParagraphs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.85"
                             LineHeight="19" Margin="0,0,0,8" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Popup IsOpen="{Binding ProtonSettingsPopupOpen, Mode=TwoWay}"
           PlacementTarget="{Binding #ProtonSettingsButton}"
           Placement="Bottom"
           VerticalOffset="4"
           IsLightDismissEnabled="True">
      <Border Background="#1e1e24" BorderBrush="#3a3a40" BorderThickness="1"
              CornerRadius="8" Padding="16,14,16,16" Width="470" Margin="16,4,16,16"
              DataContext="{Binding ProtonSettings}"
              x:DataType="vm:ProtonSettingsViewModel">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding GameName}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
          <StackPanel Spacing="6">
            <TextBlock Text="WINE PREFIX (OVERRIDE)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2" Opacity="0.45" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding PrefixPath, Mode=TwoWay}" Width="340"
                       Watermark="Empty = use the global prefix setting" />
              <Button Content="Browse" Command="{Binding BrowseCommand}" />
            </StackPanel>
            <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                       Text="Resolution order: this prefix, then the global prefix from Settings, then compatdata/&lt;appid&gt; next to the game." />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="PROTON ENV VARS (OVERRIDE)" FontSize="10" FontWeight="SemiBold" LetterSpacing="1.2" Opacity="0.45" />
            <TextBox Text="{Binding EnvironmentVariables, Mode=TwoWay}"
                     Watermark="e.g. PROTON_LOG=1 PROTON_USE_WINED3D=1" />
            <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                       Text="Whitespace-separated KEY=VALUE list merged into the game's environment. Empty = use the global setting." />
          </StackPanel>
          <Button Content="Save" Command="{Binding SaveCommand}" HorizontalAlignment="Right" MinWidth="110" />
        </StackPanel>
      </Border>
    </Popup>

    <Border Grid.RowSpan="3" IsVisible="{Binding IsMediaViewerOpen}" Background="#E6000000"
            ZIndex="100" PointerPressed="OnMediaOverlayPressed">
      <Grid RowDefinitions="Auto,*">
        <Button Grid.Row="0" Classes="iconbtn" Width="40" Height="40" HorizontalAlignment="Right"
                Margin="0,20,24,0" ToolTip.Tip="Close" Focusable="False"
                Command="{Binding CloseMediaViewerCommand}">
          <PathIcon Width="16" Height="16"
                    Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
        </Button>
        <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True" Background="#141419"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,8,24,24">
          <Image Source="{Binding ViewedMediaImageUrl, Converter={StaticResource UrlToBitmap}}"
                 Stretch="Uniform" MaxWidth="1100" MaxHeight="620" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
