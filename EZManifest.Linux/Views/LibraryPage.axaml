<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:EZManifest.Linux.ViewModels"
            xmlns:models="using:EZManifest.Models"
            xmlns:svc="using:EZManifest.Linux.Services"
            x:Class="EZManifest.Linux.Views.LibraryPage">
  <UserControl.Resources>
    <svc:PathToImageConverter x:Key="PathToImage" />
    <svc:UrlToBitmapConverter x:Key="UrlToBitmap" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.card:pointerover">
      <Setter Property="Background" Value="#26262e" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1e1e24" />
      <Setter Property="BorderBrush" Value="#3a3a40" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Border.detail">
      <Setter Property="Background" Value="#1e1e24" />
      <Setter Property="BorderBrush" Value="#3a3a40" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.play">
      <Setter Property="Background" Value="#0F9D58" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.play:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#18C46A" />
    </Style>
    <Style Selector="Button.iconbtn">
      <Setter Property="Background" Value="#2a2a30" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.mediabtn">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="Black" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="16,12,16,16">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="8,0,0,12">
      <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="Search games..." Width="260" />
      <Button Content="Refresh" Command="{Binding RefreshCommand}" />
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Opacity="0.6" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding FilteredApps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="models:GameEntry">
            <Border Classes="card" Margin="0,0,10,10" Width="200"
                    PointerReleased="OnCardPointerReleased" Tag="{Binding}">
              <StackPanel>
                <Border Height="230" CornerRadius="8,8,0,0" ClipToBounds="True">
                  <Grid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" Opacity="0.55" Text="No art"
                               IsVisible="{Binding CoverArtIsMissing}" />
                    <Image Source="{Binding Image, Converter={StaticResource PathToImage}}" Stretch="UniformToFill"
                           IsVisible="{Binding HasCoverArt}" />
                    <TextBlock Text="Play" Foreground="White" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                               IsVisible="{Binding IsInstalled}" />
                  </Grid>
                </Border>
                <StackPanel Spacing="6" Margin="10,8,10,10">
                  <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.7"
                             Text="{Binding InstallSizeText}"
                             IsVisible="{Binding HasInstallSize}" />
                  <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}"
                             TextWrapping="Wrap" MaxLines="2" TextAlignment="Center"
                             MinHeight="36" />
                  <Button Classes="play" Content="Play" HorizontalAlignment="Stretch"
                          Command="{Binding $parent[ItemsControl].DataContext.PlayCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="detail" Margin="0,12,0,0" Padding="20,14,20,16"
            IsVisible="{Binding HasSelectedGame}">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" x:DataType="models:GameEntry"
              DataContext="{Binding SelectedGame}">
          <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
              <StackPanel Spacing="2">
                <TextBlock FontSize="10" Opacity="0.6" Text="INSTALL SIZE" IsVisible="{Binding HasInstallSize}" />
                <TextBlock FontSize="14" Text="{Binding InstallSizeText}" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock FontSize="10" Opacity="0.6" Text="STATUS" />
                <TextBlock FontSize="14" Text="{Binding $parent[UserControl].DataContext.SelectedGameStatus}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" Classes="iconbtn" Width="40" Height="40" Margin="8,0,0,0"
                  ToolTip.Tip="Open install folder"
                  Command="{Binding $parent[UserControl].DataContext.OpenFolderCommand}"
                  CommandParameter="{Binding}">
            <PathIcon Width="16" Height="16"
                      Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" />
          </Button>
          <Button Grid.Column="2" Classes="iconbtn" Width="40" Height="40" Margin="8,0,0,0"
                  ToolTip.Tip="Store page"
                  Command="{Binding $parent[UserControl].DataContext.OpenStorePageCommand}"
                  CommandParameter="{Binding}">
            <PathIcon Width="16" Height="16"
                      Data="M16.36,14C16.44,13.34 16.5,12.68 16.5,12C16.5,11.32 16.44,10.66 16.36,10H19.74C19.9,10.64 20,11.31 20,12C20,12.69 19.9,13.36 19.74,14H16.36M14.59,19.56C15.19,18.45 15.65,17.25 15.97,16H18.92C17.96,17.65 16.43,18.93 14.59,19.56M14.34,14H9.66C9.56,13.34 9.5,12.68 9.5,12C9.5,11.32 9.56,10.65 9.66,10H14.34C14.43,10.65 14.5,11.32 14.5,12C14.5,12.68 14.43,13.34 14.34,14M12,4.03C13.17,5.63 14.11,7.58 14.66,9.53H9.34C9.89,7.58 10.83,5.63 12,4.03M5.08,16H8.03C8.35,17.25 8.81,18.45 9.41,19.56C7.57,18.93 6.04,17.65 5.08,16M8.03,8H5.08C6.04,6.34 7.57,5.06 9.41,4.44C8.81,5.55 8.35,6.75 8.03,8M4.26,14C4.1,13.36 4,12.69 4,12C4,11.31 4.1,10.64 4.26,10H7.64C7.56,10.66 7.5,11.32 7.5,12C7.5,12.68 7.56,13.34 7.64,14H4.26M12,19.97C10.83,18.36 9.89,16.41 9.34,14H14.66C14.11,16.41 13.17,18.36 12,19.97M18.92,8H15.97C15.65,6.75 15.19,5.55 14.59,4.44C16.43,5.07 17.96,6.34 18.92,8M12,2C7.58,2 4,5.58 4,10C4,14.42 7.58,18 12,18C16.42,18 20,14.42 20,10C20,5.58 16.42,2 12,2Z" />
          </Button>
          <Button Grid.Column="3" Classes="iconbtn" Width="40" Height="40" Margin="8,0,0,0"
                  ToolTip.Tip="Uninstall"
                  Command="{Binding $parent[UserControl].DataContext.UninstallCommand}"
                  CommandParameter="{Binding}">
            <PathIcon Width="16" Height="16"
                      Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M9,9H11V17H9V9M13,9H15V17H13V9Z" />
          </Button>
          <Button Grid.Column="4" Classes="iconbtn" Width="40" Height="40" Margin="8,0,0,0"
                  ToolTip.Tip="Close details"
                  Command="{Binding $parent[UserControl].DataContext.CloseDetailCommand}">
            <PathIcon Width="16" Height="16"
                      Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
          </Button>
        </Grid>

        <Image Source="{Binding SelectedGameHeroPath, Converter={StaticResource PathToImage}}" Stretch="Uniform" MaxHeight="220" />

        <StackPanel Spacing="6">
          <TextBlock FontSize="10" Opacity="0.6" Text="GAME MEDIA" />
          <ItemsControl ItemsSource="{Binding SelectedGameMedia}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:GameMediaItem">
                <Button Classes="mediabtn"
                        Command="{Binding $parent[UserControl].DataContext.OpenMediaCommand}"
                        CommandParameter="{Binding}">
                  <Grid Width="200" Height="112" Background="Black">
                    <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UrlToBitmap}}" Stretch="Uniform" />
                    <TextBlock Text="▶ Video" FontSize="10" Foreground="White"
                               IsVisible="{Binding IsVideo}" Margin="6,4"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="6" x:DataType="models:GameEntry" DataContext="{Binding SelectedGame}">
          <TextBlock FontSize="10" Opacity="0.6" Text="ABOUT THE GAME" />
          <TextBlock Text="{Binding AboutTheGame}" TextWrapping="Wrap" Opacity="0.85" />
        </StackPanel>

        <StackPanel Spacing="6" x:DataType="models:GameEntry" DataContext="{Binding SelectedGame}">
          <TextBlock FontSize="10" Opacity="0.6" Text="WINE PREFIX (OVERRIDE)" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding ProtonPrefixPath, Mode=TwoWay}" Width="420"
                     Watermark="Empty = use the global prefix setting" />
            <Button Content="Browse"
                    Command="{Binding $parent[UserControl].DataContext.BrowseGamePrefixCommand}"
                    CommandParameter="{Binding}" />
            <Button Content="Save"
                    Command="{Binding $parent[UserControl].DataContext.SaveGamePrefixCommand}"
                    CommandParameter="{Binding}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
