<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            x:Class="EZManifest.Linux.Views.LibraryPage">
    <Grid RowDefinitions="Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="Search games…" Width="260" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Games}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="4,8">
                        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" />
                            <TextBlock Text="{Binding InstallPath}" Foreground="Gray" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="▶ Play" Command="{Binding $parent[ItemsControl].DataContext.PlayCommand}" CommandParameter="{Binding}" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="Open folder" Command="{Binding $parent[ItemsControl].DataContext.OpenFolderCommand}" CommandParameter="{Binding}" Margin="0,0,8,0" />
                        <Button Grid.Column="3" Content="Uninstall" Command="{Binding $parent[ItemsControl].DataContext.UninstallCommand}" CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
