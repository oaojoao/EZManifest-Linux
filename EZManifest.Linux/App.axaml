<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EZManifest.Linux.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Avalonia.Themes.Fluent/FluentTheme.axaml"/>
                <ResourceInclude Source="avares://Avalonia.Fonts.Inter/FontInter.axaml"/>
                <ResourceInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
